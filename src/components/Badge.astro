---
import "../styles/global.css";
---

<div class="flex items-center">
    <span class="relative flex h-3 w-3 mr-2">
        <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75"
            style="background-color: var(--badge-dot-ping)"></span>
        <span
            class="relative inline-flex rounded-full h-3 w-3"
            style="background-color: var(--badge-dot)"></span>
    </span>
    <span
        class="glass px-3 py-1 text-xs font-bold rounded-full border shadow-sm transition-colors duration-300"
        style="background-color: var(--badge-bg); color: var(--badge-text); borderColor: var(--badge-border)"
    >
        <slot />
    </span>
</div>
