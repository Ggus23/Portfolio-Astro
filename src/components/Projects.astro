---
import "../styles/global.css";
import Flask from "./icons/Flask.astro";
import Python from "./icons/Python.astro";
import IA from "./icons/IA.astro";
import ML from "./icons/ML.astro";
import DPL from "./icons/DPL.astro";
import VA from "./icons/VA.astro";
import Agriculture from "./icons/Agriculture.astro";
import Health from "./icons/Health.astro";
import NeuronalNetwork from "./icons/Neuronal-Network.astro";
import GitHubIcon from "./icons/GitHub.astro";

import LinkButton from "./LinkButton.astro";
import Laravel from "./icons/Laravel.astro";
import Vue from "./icons/Vue.astro";
import Inertia from "./icons/Inertia.astro";
const TAGS = {
  Python: {
    name: "Python",
    class: "bg-[#306998] text-white",
    icon: Python,
  },
  IA: {
    name: "IA",
    class: "bg-[#000000] text-[#FFFFFF]",
    icon: IA,
  },
  Flask: {
    name: "Flask",
    class: "bg-[#000000] text-[#FFFFFF]",
    icon: Flask,
  },
  ML: {
    name: "Machine Learning",
    class: "bg-[#FF6F00] text-[#FFFFFF]",
    icon: ML,
  },
  DPL: {
    name: "Deep Learning",
    class: "bg-[#FF6F00] text-[#FFFFFF]",
    icon: DPL,
  },
  VA: {
    name: "Visión Artificial",
    class: "bg-[#0078D7] text-[#FFFFFF]",
    icon: VA,
  },
  Agriculture: {
    name: "Agricultura",
    class: "bg-[#4CAF50] text-[#FFFFFF]",
    icon: Agriculture,
  },
  Health: {
    name: "Salud",
    class: "bg-[#E91E63] text-[#FFFFFF]",
    icon: Health,
  },
  CNN: {
    name: "CNN",
    class: "bg-[#FF6F00] text-[#FFFFFF]",
    icon: NeuronalNetwork,
  },
  LARAVEL: {
    name: "Laravel",
    class: "bg-[#FF2D20] text-white",
    icon: Laravel,
  },
  VUE: {
    name: "Vue.js",
    class: "bg-[#4FC08D] text-white",
    icon: Vue,
  },
  INERTIA: {
    name: "Inertia.js",
    class: "bg-[#9553E9] text-white",
    icon: Inertia,
  },
};

const PROJECTS = [
  {
    title: "Resto POS - Sistema de Gestión de Restaurantes",
    description:
      "Sistema de Punto de Venta (POS) completo para restaurantes. Gestión de roles (Admin, Cajero, Cocina), toma de pedidos en tiempo real, flujo de caja y administración de menú. Desarrollado con Laravel, Vue.js e Inertia.js.",
    github: "https://github.com/Ggus23/RestoBurguerBichotas",
    image: "projects/Resto-Burguer.png",
    tags: [TAGS.LARAVEL, TAGS.VUE, TAGS.INERTIA],
  },
  {
    title: "Sistema de Recomendación Inteligente",
    description:
      "Desarrollo de un sistema de recomendación basado en datos del usuario, implementado con Python y Flask. Incluye lógica de recomendación, backend funcional y una interfaz web interactiva.",
    github: "https://github.com/Ggus23/Sistema-Recomendaciones",
    image: "projects/Recom-Peli.webp",
    tags: [TAGS.Python, TAGS.Flask, TAGS.ML],
  },
  {
    title: "Detección de Enfermedades en Uvas",
    description:
      "Sistema de visión por computadora para la clasificación de enfermedades en uvas utilizando redes neuronales convolucionales (CNN) y TensorFlow.",
    github:
      "https://github.com/Ggus23/SISTEMA-ANALIZADOR-DE-ENFERMEDADES-HOJAS-DE-UVA",
    image: "projects/AN-HO-UVAS.webp",
    tags: [TAGS.Python, TAGS.Flask, TAGS.CNN, TAGS.VA, TAGS.Agriculture],
  },
  {
    title: "Predicción de Enfermedades Pulmonares",
    description:
      "Aplicación basada en inteligencia artificial para la detección de enfermedades pulmonares a partir de imágenes médicas, integrada en una app web con Flask.",
    github: "https://github.com/Ggus23/IA-Doctor-Pulmon",
    image: "projects/AN-PULMONES.webp",
    tags: [TAGS.Python, TAGS.IA, TAGS.DPL, TAGS.Health],
  },
];
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
  {
    PROJECTS.map(({ image, title, description, tags, github }) => (
      <article class="glass glass-hover rounded-2xl overflow-hidden group flex flex-col h-full">
        <div class="relative aspect-video overflow-hidden">
          <img
            alt={title}
            class="object-cover w-full h-full transition-transform duration-500 group-hover:scale-110"
            loading="lazy"
            src={image}
          />
          <div class="absolute inset-0 bg-gradient-to-t from-background/90 via-background/20 to-transparent" />

          {github && (
            <div class="absolute top-4 right-4 translate-y-2 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300">
              <a
                href={github}
                target="_blank"
                class="glass p-2 rounded-full hover:bg-white/20 dark:hover:bg-white/10 transition-colors inline-block"
                title="Ver código"
              >
                <GitHubIcon class="size-6 text-text" />
              </a>
            </div>
          )}
        </div>

        <div class="p-6 flex flex-col flex-1">
          <div class="flex flex-wrap gap-2 mb-4">
            {tags.map((tag) => (
              <span
                class={`flex items-center gap-x-1.5 rounded-full text-[10px] font-bold uppercase tracking-wider py-1 px-3 ${tag.class} bg-opacity-10 dark:bg-opacity-20 border border-current shadow-sm`}
              >
                <tag.icon class="size-3" />
                {tag.name}
              </span>
            ))}
          </div>

          <h3 class="text-xl font-bold text-text mb-2 group-hover:text-primary transition-colors">
            {title}
          </h3>

          <p class="text-text-muted text-sm leading-relaxed mb-6 flex-1">
            {description}
          </p>

          {github && (
            <footer class="flex items-center justify-between mt-auto pt-4 border-t border-black/5 dark:border-white/5">
              <LinkButton href={github} class="text-xs">
                <GitHubIcon class="size-4 mr-2" />
                Source Code
              </LinkButton>
            </footer>
          )}
        </div>
      </article>
    ))
  }
</div>
