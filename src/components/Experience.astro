---
import "../styles/global.css";
import ExperienceItem from "./ExperienceItem.astro";

const EXPERIENCE = [
  {
    date: "2025 - 2026",
    title: "Aprendizaje y Dominio del Stack VIL",
    description:
      "Consolidación de habilidades como Desarrollador Full Stack Junior mediante la creación de 'Resto POS'. Implementación de una arquitectura monolítica con el stack VIL (Vue, Inertia, Laravel), desarrollando funcionalidades críticas como gestión de menús, toma de pedidos en tiempo real y control de caja.",
    link: "",
  },
  {
    date: "2022 - Actualidad",
    title: "Desarrollador Full Stack Independiente",
    description:
      "Desarrollo de sistemas de gestión y aplicaciones web a medida, enfocándose en soluciones robustas y escalables como Puntos de Venta (POS) y ERPs. Integración selectiva de tecnologías modernas y, ocasionalmente, módulos de inteligencia artificial según las necesidades específicas del proyecto.",
    link: "#",
  },
  {
    date: "2023 - 2024",
    title: "Desarrollador de Sistemas de Inteligencia Artificial",
    description:
      "Diseño e implementación de modelos de aprendizaje automático aplicados a visión por computadora y análisis predictivo. Desarrollo de APIs con Flask para consumo de modelos de IA y despliegue de soluciones funcionales.",
    link: "",
  },
  {
    date: "2022 - 2023",
    title: "Desarrollador Web Full Stack",
    description:
      "Desarrollo de aplicaciones web completas utilizando HTML, CSS, JavaScript y Python. Implementación de sistemas CRUD, autenticación de usuarios y diseño de interfaces responsivas.",
    link: "",
  },
];
---

<ol class="relative ml-3">
  {
    EXPERIENCE.map((experience) => (
      <li class="">
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>
