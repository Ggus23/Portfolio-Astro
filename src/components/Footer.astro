---
import "../styles/global.css";
const currentYear = new Date().getFullYear();
---

<footer
    class="glass border-t-0 rounded-2xl m-4 mt-20 mb-10 w-full max-w-4xl mx-auto overflow-hidden"
>
    <div class="px-6 py-8 md:flex md:items-center md:justify-between">
        <span class="text-sm text-text-muted sm:text-center">
            © {currentYear}
            <a
                href="https://www.linkedin.com/in/agustin-pacar-trive%C3%B1o-43a40a2a7"
                class="hover:text-primary transition-colors font-semibold"
            >
                Agustin Pacar
            </a>. Todos los derechos reservados.
        </span>

        <ul
            class="flex flex-wrap items-center mt-4 text-sm font-medium text-text-muted sm:mt-0"
        >
            <li>
                <a
                    href="#sobre-mi"
                    class="hover:text-text transition-colors me-4 md:me-6"
                    >Sobre mí</a
                >
            </li>
            <li>
                <a
                    href="mailto:pacaragustin@gmail.com"
                    class="hover:text-text transition-colors">Contacto</a
                >
            </li>
        </ul>
    </div>
</footer>
