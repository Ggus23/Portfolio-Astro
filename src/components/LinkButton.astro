---
import "../styles/global.css";
const { href, class: className } = Astro.props;
---

<a
  target="_blank"
  href={href}
  role="link"
  class={`
      inline-flex items-center justify-center gap-2 px-4 py-2 
      glass glass-hover text-text hover:text-primary
      text-sm font-medium transition-all transform active:scale-95
      rounded-xl shadow-sm hover:shadow-primary/20
      ${className}
    `}
>
  <slot />
</a>
